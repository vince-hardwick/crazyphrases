# Public directories must never reveal their file inventory.
Options -Indexes

# Keep repository documents and deployment metadata private, even if left behind.
<FilesMatch "(?i)^(?:\..*|.*\.md|package(?:-lock)?\.json)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:\.git|\.github|tools|docs|tests|supabase|output|node_modules)(?:/|$) - [F,END,NC]

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
